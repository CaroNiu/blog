---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '用生产实战说话的后端工程师' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --text: #1f2328;
        --text-secondary: #59636e;
        --accent: #0969da;
        --border: #d1d9e0;
        --bg: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text: #f0f6fc;
          --text-secondary: #9198a1;
          --accent: #4493f8;
          --border: #3d444d;
          --bg: #0d1117;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.75;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      article h1 {
        line-height: 1.4;
      }
      article img {
        max-width: 100%;
      }
      article pre {
        overflow-x: auto;
        padding: 1rem;
        border-radius: 8px;
        background: rgba(128, 128, 128, 0.12);
      }
      article code {
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 0.9em;
      }
      article blockquote {
        margin: 0;
        padding: 0.25rem 1rem;
        border-left: 3px solid var(--border);
        color: var(--text-secondary);
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
