---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const CATEGORY_META: Record<string, { name: string; desc: string }> = {
  backend: { name: '后端进阶', desc: '架构、中间件与系统设计' },
  practice: { name: '实战复盘', desc: '生产事故、踩坑与方案落地' },
  ai: { name: 'AI×程序员', desc: 'AI 时代的开发方式与提效实践' },
  career: { name: '职业思考', desc: '行业观察与成长路径' },
};

// draft 文章只在本地开发模式可见
const posts = await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const grouped = Object.keys(CATEGORY_META).map((key) => ({
  key,
  ...CATEGORY_META[key],
  posts: posts.filter((p) => p.data.category === key),
}));

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title="后端不背锅 · 用实战说话">
  <header>
    <h1 style="margin-bottom: 0.25rem;">后端不背锅</h1>
    <p style="color: var(--text-secondary); margin-top: 0;">
      用生产实战说话的后端工程师 · 后端进阶 / 实战复盘 / AI 提效
    </p>
  </header>

  {grouped.map(({ key, name, desc, posts: items }) => (
    <section>
      <h2 style="border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
        {name}
        <small style="color: var(--text-secondary); font-weight: normal;">· {desc}（{items.length}）</small>
      </h2>
      {items.length === 0 && <p style="color: var(--text-secondary);">内容整理中…</p>}
      <ul style="list-style: none; padding: 0;">
        {items.map((post) => (
          <li style="margin-bottom: 1.25rem;">
            <a href={`/posts/${post.id}/`} style="font-weight: 600; font-size: 1.05em;">
              {post.data.title}
            </a>
            {import.meta.env.DEV && post.data.draft && (
              <span style="color: var(--text-secondary);">［草稿］</span>
            )}
            <div style="color: var(--text-secondary); font-size: 0.9em;">
              {fmt(post.data.pubDate)}
              {post.data.summary && ` · ${post.data.summary}`}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
